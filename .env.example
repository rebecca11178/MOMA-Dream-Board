# The prototype runs fully client-side with a mock "brain" by default,
# so none of these are required to run `npm run dev`.
#
# They are here for when the real backend (Supabase Edge Functions) is wired in.
# Keep ANTHROPIC/VOYAGE/service-role keys server-side only — never expose to the client.

# --- Client-safe (used by the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "mock" (default) or "live" once Edge Functions exist.
VITE_BRAIN_MODE=mock

# --- Server-side only (Supabase Edge Functions) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
